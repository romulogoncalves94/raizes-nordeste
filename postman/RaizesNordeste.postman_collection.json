            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COZINHA\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/pedidos/{{idPedidoSucesso}}/status", "host": ["{{baseUrl}}"], "path": ["api", "pedidos", "{{idPedidoSucesso}}", "status"] },
            "description": "Cenário negativo: o pedido já está ENTREGUE (status final) — qualquer nova transição deve ser bloqueada com 409."
          }
