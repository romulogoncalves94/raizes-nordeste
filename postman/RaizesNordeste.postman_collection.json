                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_gerente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ENTREGUE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/pedidos/{{idPedidoSucesso}}/status", "host": ["{{baseUrl}}"], "path": ["api", "pedidos", "{{idPedidoSucesso}}", "status"] },
            "description": "Cenário positivo: transição para ENTREGUE credita pontos de fidelidade automaticamente (1 ponto por R$1,00 do valorTotal, arredondado para baixo) — exercita o INSERT em historico_pontos com tipo ACUMULADO."
          }
        },
        {
          "name": "Consultar saldo de fidelidade após entrega (positivo, 200)",
          "event": [
            {
              "listen": "test",
