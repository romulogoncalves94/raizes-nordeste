    {
      "name": "08 - Campanhas",
      "item": [
        {
          "name": "Criar campanha vigente (positivo, 201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const agora = new Date();",
                  "const inicio = new Date(agora.getTime() - 24*60*60*1000);",
                  "const fim = new Date(agora.getTime() + 30*24*60*60*1000);",
                  "function toLocalDateTime(d) { return d.toISOString().split('.')[0]; }",
                  "pm.collectionVariables.set('campanhaDataInicio', toLocalDateTime(inicio));",
                  "pm.collectionVariables.set('campanhaDataFim', toLocalDateTime(fim));",
                  "pm.collectionVariables.set('campanhaDataFimInvalida', toLocalDateTime(new Date(inicio.getTime() - 24*60*60*1000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Campanha retorna vigente=true', () => pm.expect(json.vigente).to.eql(true));",
                  "pm.collectionVariables.set('idCampanha', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_gerente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Semana do Nordeste\",\n  \"percentualDesconto\": 10.00,\n  \"dataInicio\": \"{{campanhaDataInicio}}\",\n  \"dataFim\": \"{{campanhaDataFim}}\",\n  \"ativa\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/campanhas", "host": ["{{baseUrl}}"], "path": ["api", "campanhas"] },
            "description": "Cenário positivo: campanha com período (ontem até +30 dias) que cobre o momento atual — fica vigente imediatamente."
          }
        },
        {
          "name": "Criar campanha com dataFim antes de dataInicio (negativo, 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
                  "const json = pm.response.json();",
                  "pm.test('Mensagem menciona vigência/data', () => pm.expect(json.message.toLowerCase()).to.include('data'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_gerente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Campanha com Vigência Inválida\",\n  \"percentualDesconto\": 5.00,\n  \"dataInicio\": \"{{campanhaDataInicio}}\",\n  \"dataFim\": \"{{campanhaDataFimInvalida}}\",\n  \"ativa\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/campanhas", "host": ["{{baseUrl}}"], "path": ["api", "campanhas"] },
            "description": "Cenário negativo: dataFim anterior à dataInicio viola a regra de vigência (BusinessRuleException) — 409 Conflict."
          }
        },
        {
          "name": "Listar campanhas vigentes (positivo, 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Campanha criada aparece na lista de vigentes', () => {",
                  "  const ids = json.map((c) => c.id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('idCampanha'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{token_gerente}}" } ],
            "url": { "raw": "{{baseUrl}}/api/campanhas/vigentes", "host": ["{{baseUrl}}"], "path": ["api", "campanhas", "vigentes"] },
            "description": "Cenário positivo: lista as campanhas ativas e dentro do período — confirma que a campanha criada é retornada."
          }
        }
      ]
    }
  ]
