            "header": [ { "key": "Authorization", "value": "Bearer {{token_cliente}}" } ],
            "url": { "raw": "{{baseUrl}}/api/fidelidade/{{idUsuarioCliente}}", "host": ["{{baseUrl}}"], "path": ["api", "fidelidade", "{{idUsuarioCliente}}"] },
            "description": "Cenário positivo: confirma que o acúmulo automático de pontos (request anterior) refletiu no saldo — também serve de teste de regressão para a constraint de `historico_pontos.tipo` (corrigida na migration V4)."
          }
        },
        {
          "name": "Atualizar status de pedido já finalizado (negativo, 409)",
          "event": [
